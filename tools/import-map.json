    "kit-saudi-workbench": {
      "name": "沙特数字员工底座",
      "category": "内置组件",
      "description": "rfq-quote / bid-decision / advisory-report 三个数字员工共用的统一收件 + 三栏工作台底座与案件存储。",
      "seeds": [
        "src:renderer/workbenches/saudi",
        "src:main/services/saudiCaseStore.ts",
        "src:main/services/saudiDataPack.ts",
        "src:main/services/saudiOutputBuilder.ts",
        "src:main/services/saudiEndToEnd.test.ts",
        "src:main/services/saudiPackIngestion.test.ts",
        "res:saudi-demo"
      ],
      "data": {
        "paths": [
          "totalclaw-agent/cases/case-store.json",
          "totalclaw-agent/saudi/data-pack.json"
        ],
        "localStorage": []
      }
    },
