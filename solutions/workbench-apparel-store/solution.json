{
  "manifestVersion": 2,
  "schemaVersion": 1,
  "id": "workbench-apparel-store",
  "name": "服装AI试衣",
  "aliases": [
    "apparel-store",
    "服装实体店智能体"
  ],
  "version": "2.0.3",
  "kind": "workbench",
  "category": "服装零售",
  "icon": "icon-solutions",
  "order": 170,
  "description": "AI 一键换装：顾客手机扫码或店员电脑上传照片，自选背景、姿势、发型生成试穿图，手机电脑同时查看；试穿码到店核销，试穿数据看板指导主推款。",
  "detail": "七步固定流程：选衣服（AI 自动打标签）→ 顾客照片与授权 → AI 形象分析推荐造型 → 选背景（30 项）/ 姿势（20 项）/ 发型（25 项）及细分场景 → AI 合成试穿图 → 手机与电脑同时查看、带门店名与试穿码保存 → 到店凭码试实物（尺码助手提前备货）。门店手机端是店内 Wi-Fi 下的网页，不需要小程序与试衣镜；照片只存在门店电脑，到期自动删除，顾客可随时一键删除。",
  "access": {
    "requiresSolutionGrant": true,
    "feature": "qiye_api_advanced",
    "hidden": false
  },
  "compat": {
    "minAppVersion": "2.0.6",
    "hostApi": 2
  },
  "runtime": {
    "mode": "dynamic",
    "runner": "workbench",
    "route": "/workbenches/apparel-store",
    "renderer": "src/renderer/views/ApparelStoreWorkbenchView.vue",
    "main": null,
    "hotSwap": false,
    "routes": [
      {
        "path": "/workbenches/apparel-store",
        "name": "ApparelStoreWorkbench"
      }
    ],
    "entries": {
      "renderer": "dist/renderer.mjs",
      "style": "dist/style.css",
      "hostModules": "dist/host-modules.json"
    }
  },
  "dependsOn": [],
  "data": {
    "schemaVersion": 1,
    "paths": [
      "apparel-store/"
    ],
    "localStorage": [
      "totalclaw:apparel-store"
    ]
  },
  "capabilities": [],
  "largeAssets": [],
  "distribution": {
    "channel": "stable",
    "path": "solutions/workbench-apparel-store",
    "files": [
      "solution.json",
      "README.md",
      "CHANGELOG.md",
      "dist/",
      "migrations/"
    ]
  }
}
