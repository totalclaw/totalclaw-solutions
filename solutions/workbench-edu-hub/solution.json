{
  "manifestVersion": 2,
  "schemaVersion": 1,
  "id": "workbench-edu-hub",
  "name": "智能备课助教",
  "aliases": [
    "edu-hub",
    "AI 学习中心（文档生成教案）"
  ],
  "version": "2.0.3",
  "kind": "workbench",
  "category": "教育",
  "icon": "icon-solutions",
  "order": 10,
  "description": "导入教材一键生成教案、学生要点与小测；启动校内服务，学生扫码用浏览器学习，进展实时回看。",
  "detail": "上传 Word 或 PDF 教材，AI 自动拆分课时并生成教案、学生要点与随堂小测，支持中、英、阿三语切换；一键启动校内服务后，学生扫码即可在浏览器里学习，教师端实时回看每个学生的进展与答题情况。",
  "shortcuts": [
    "导入教材生成教案",
    "启动校内服务",
    "学生扫码学习"
  ],
  "highlights": [
    "一键生成教案/要点/小测",
    "中英阿三语切换",
    "实时回看学习进展"
  ],
  "access": {
    "requiresSolutionGrant": false,
    "feature": "qiye_api_advanced",
    "hidden": false
  },
  "compat": {
    "minAppVersion": "2.0.5",
    "hostApi": 2
  },
  "runtime": {
    "mode": "dynamic",
    "runner": "workbench",
    "route": "/workbenches/edu-hub",
    "renderer": "src/renderer/views/EduHubWorkbenchView.vue",
    "main": "src/main/ipc/eduHub.ipc.ts",
    "hotSwap": false,
    "routes": [
      {
        "path": "/workbenches/edu-hub",
        "name": "EduHubWorkbench"
      }
    ],
    "entries": {
      "renderer": "dist/renderer.mjs",
      "style": "dist/style.css",
      "main": "dist/main.cjs",
      "hostModules": "dist/host-modules.json"
    }
  },
  "dependsOn": [],
  "data": {
    "schemaVersion": 1,
    "paths": [
      "edu-hub/"
    ],
    "localStorage": [
      "totalclaw:edu-hub"
    ]
  },
  "capabilities": [],
  "largeAssets": [],
  "distribution": {
    "channel": "stable",
    "path": "solutions/workbench-edu-hub",
    "files": [
      "solution.json",
      "README.md",
      "CHANGELOG.md",
      "dist/",
      "migrations/"
    ]
  }
}
