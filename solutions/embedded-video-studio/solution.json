{
  "manifestVersion": 2,
  "schemaVersion": 1,
  "id": "embedded-video-studio",
  "name": "短视频创作与发布工作台",
  "aliases": [
    "video-studio"
  ],
  "version": "2.0.0",
  "kind": "workbench",
  "category": "内置",
  "icon": "icon-solutions",
  "order": 290,
  "description": "从素材整理、脚本、配音配乐到成片审核，一次准备抖音、快手、小红书和微信视频号版本。",
  "detail": "从素材整理、脚本撰写、配音配乐到成片审核一条流水线，一次制作即可同时准备好抖音、快手、小红书与微信视频号四个平台的版本与文案。",
  "shortcuts": [
    "素材整理",
    "脚本配音配乐",
    "成片审核发布"
  ],
  "highlights": [
    "一次制作四平台版本",
    "抖音/快手/小红书/视频号",
    "成片审核后发布"
  ],
  "access": {
    "requiresSolutionGrant": true,
    "feature": "command_search_execute_list",
    "hidden": false
  },
  "compat": {
    "minAppVersion": "2.0.5",
    "hostApi": 2
  },
  "runtime": {
    "mode": "dynamic",
    "runner": "workbench",
    "route": "/video-studio",
    "renderer": "src/renderer/views/VideoStudioView.vue",
    "main": null,
    "hotSwap": false,
    "routes": [
      {
        "path": "/video-studio",
        "name": "VideoStudio"
      }
    ],
    "entries": {
      "renderer": "dist/renderer.mjs",
      "style": "dist/style.css",
      "hostModules": "dist/host-modules.json"
    }
  },
  "dependsOn": [],
  "data": {
    "schemaVersion": 1,
    "paths": [],
    "localStorage": [
      "totalclaw:video-studio"
    ]
  },
  "capabilities": [],
  "largeAssets": [],
  "distribution": {
    "channel": "stable",
    "path": "solutions/embedded-video-studio",
    "files": [
      "solution.json",
      "README.md",
      "CHANGELOG.md",
      "dist/",
      "migrations/"
    ]
  }
}
