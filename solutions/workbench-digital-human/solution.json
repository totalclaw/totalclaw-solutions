{
  "manifestVersion": 2,
  "schemaVersion": 1,
  "id": "workbench-digital-human",
  "name": "多媒体创作与发布工作台 · 数字人口播与直播",
  "aliases": [
    "digital-human",
    "数字人口播与直播工作台"
  ],
  "version": "2.0.3",
  "kind": "workbench",
  "category": "数字人",
  "icon": "icon-solutions",
  "order": 130,
  "description": "文稿或 LLM 输出交给数字人念出来：离线出成片，或起一路实时会话做直播与教课。",
  "detail": "把文稿或 LLM 输出交给数字人念出来：离线渲染出成片用于口播视频，或起一路实时会话让数字人直播带课，形象与音色都可按品牌配置。",
  "shortcuts": [
    "文稿生成口播成片",
    "发起实时直播会话",
    "配置形象音色"
  ],
  "highlights": [
    "离线出成片或实时直播",
    "形象音色可按品牌配置",
    "支持直播带课"
  ],
  "access": {
    "requiresSolutionGrant": false,
    "feature": "digital_human",
    "hidden": false
  },
  "compat": {
    "minAppVersion": "2.0.5",
    "hostApi": 2
  },
  "runtime": {
    "mode": "dynamic",
    "runner": "workbench",
    "route": "/workbenches/digital-human",
    "renderer": "src/renderer/views/DigitalHumanWorkbenchView.vue",
    "main": "src/main/ipc/digitalHuman.ipc.ts",
    "hotSwap": false,
    "routes": [
      {
        "path": "/workbenches/digital-human",
        "name": "DigitalHumanWorkbench"
      }
    ],
    "entries": {
      "renderer": "dist/renderer.mjs",
      "style": "dist/style.css",
      "main": "dist/main.cjs",
      "hostModules": "dist/host-modules.json"
    }
  },
  "dependsOn": [],
  "data": {
    "schemaVersion": 1,
    "paths": [],
    "localStorage": []
  },
  "capabilities": [],
  "largeAssets": [],
  "distribution": {
    "channel": "stable",
    "path": "solutions/workbench-digital-human",
    "files": [
      "solution.json",
      "README.md",
      "CHANGELOG.md",
      "dist/",
      "migrations/"
    ]
  }
}
