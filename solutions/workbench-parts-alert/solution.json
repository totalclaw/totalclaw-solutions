{
  "manifestVersion": 2,
  "schemaVersion": 1,
  "id": "workbench-parts-alert",
  "name": "配件预警与补库智能体",
  "aliases": [
    "parts-alert"
  ],
  "version": "2.0.2",
  "kind": "workbench",
  "category": "配件管理",
  "icon": "icon-solutions",
  "order": 210,
  "description": "投喂配件历史发货、采购提前期、采购在途和实时库存四类数据，算出每个配件是呆滞、冗余、健康、将缺货还是已缺货，给出处理建议和补库清单，人工检验后转采购订单，并可定时循环运算预警。",
  "detail": "五步向导：投喂四类数据 → 运算库存状态 → 检验行动计划（呆滞处理建议、有采购在途和无采购在途两类缺货管控举措）→ 确认补库清单 → 导出采购订单。库存状态、断货日和补库量都由公式算出并附算式，阈值可在规则里调整；补库清单经你确认后才生成采购订单。定时运算会读取指定文件夹里的最新数据并推送预警。",
  "access": {
    "requiresSolutionGrant": true,
    "feature": "qiye_api_advanced",
    "hidden": false
  },
  "compat": {
    "minAppVersion": "2.0.5",
    "hostApi": 2
  },
  "runtime": {
    "mode": "dynamic",
    "runner": "workbench",
    "route": "/workbenches/parts-alert",
    "renderer": "src/renderer/views/PartsAlertWorkbenchView.vue",
    "main": "src/main/ipc/partsAlert.ipc.ts",
    "hotSwap": false,
    "routes": [
      {
        "path": "/workbenches/parts-alert",
        "name": "PartsAlertWorkbench"
      }
    ],
    "entries": {
      "renderer": "dist/renderer.mjs",
      "style": "dist/style.css",
      "main": "dist/main.cjs",
      "hostModules": "dist/host-modules.json"
    }
  },
  "dependsOn": [],
  "data": {
    "schemaVersion": 1,
    "paths": [
      "parts-alert/"
    ],
    "localStorage": [
      "totalclaw:parts-alert"
    ]
  },
  "capabilities": [],
  "largeAssets": [],
  "distribution": {
    "channel": "stable",
    "path": "solutions/workbench-parts-alert",
    "files": [
      "solution.json",
      "README.md",
      "CHANGELOG.md",
      "dist/",
      "migrations/"
    ]
  }
}
