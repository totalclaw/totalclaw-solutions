{
  "manifestVersion": 2,
  "schemaVersion": 1,
  "id": "workbench-education",
  "name": "职教与高校工作台",
  "aliases": [
    "education"
  ],
  "version": "2.0.2",
  "kind": "workbench",
  "category": "教育",
  "icon": "icon-solutions",
  "order": 30,
  "description": "多 Agent 协同备课、实训辅导、学情分析、教学配图与教师审核。",
  "detail": "面向职教与高校的多 Agent 教学协同：备课组联合产出教案与实训指导，学情分析自动汇总班级薄弱点，教学配图按知识点生成，所有产出经教师审核后才进入课堂。",
  "shortcuts": [
    "查看备课教案",
    "学情分析报告",
    "教学配图"
  ],
  "highlights": [
    "多 Agent 协同备课",
    "学情自动汇总薄弱点",
    "教师审核后进课堂"
  ],
  "access": {
    "requiresSolutionGrant": true,
    "feature": "qiye_api_advanced",
    "hidden": false
  },
  "compat": {
    "minAppVersion": "2.0.5",
    "hostApi": 2
  },
  "runtime": {
    "mode": "dynamic",
    "runner": "workbench",
    "route": "/workbenches/education",
    "renderer": "src/renderer/views/EducationWorkbenchView.vue",
    "main": "src/main/ipc/educationWorkbench.ipc.ts",
    "hotSwap": false,
    "routes": [
      {
        "path": "/workbenches/education",
        "name": "EducationWorkbench"
      }
    ],
    "entries": {
      "renderer": "dist/renderer.mjs",
      "style": "dist/style.css",
      "main": "dist/main.cjs",
      "hostModules": "dist/host-modules.json"
    }
  },
  "dependsOn": [],
  "data": {
    "schemaVersion": 1,
    "paths": [],
    "localStorage": [
      "totalclaw:education"
    ]
  },
  "capabilities": [],
  "largeAssets": [],
  "distribution": {
    "channel": "stable",
    "path": "solutions/workbench-education",
    "files": [
      "solution.json",
      "README.md",
      "CHANGELOG.md",
      "dist/",
      "migrations/"
    ]
  }
}
